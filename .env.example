# LLM provider config (optional)
# Keep MODEL_PROVIDER=mock to run deterministic-only mode (no API calls needed).
# Set MODEL_PROVIDER=apim (or openai) and fill in the vars below to enable LLM-assisted agents.
MODEL_PROVIDER=mock

# --- Azure Foundry via APIM ---
MODEL_API_BASE=https://<your-apim-name>.azure-api.net
MODEL_API_KEY=
MODEL_NAME=<deployment-name>
APIM_PATH=/openai/custom/{model}/chat/completions
APIM_API_VERSION=2024-10-21
APIM_AUTH_HEADER=api-key
# APIM_AUTH_SCHEME=                   # e.g. Bearer — leave empty for plain key
# APIM_EXTRA_HEADERS={"x-tenant-id":"acme"}
APIM_INCLUDE_MODEL_IN_BODY=false

# --- Direct OpenAI (alternative) ---
# MODEL_PROVIDER=openai
# MODEL_API_BASE=https://api.openai.com/v1
# MODEL_API_KEY=
# MODEL_NAME=gpt-4o-mini
# APIM_PATH=/chat/completions
# APIM_AUTH_HEADER=Authorization
# APIM_AUTH_SCHEME=Bearer

LLM_TIMEOUT_SECONDS=20

# Optional real football API
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4